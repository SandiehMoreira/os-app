rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada login é a própria loja: todo dado mora debaixo de
    // stores/{uid}/... e só o dono desse uid pode ler ou escrever ali —
    // isso é verdade pra qualquer sub-coleção nova que vier a existir no
    // futuro (customers, serviceOrders, meta/...), sem precisar mexer
    // nesta regra de novo.
    match /stores/{storeId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == storeId;
    }
  }
}
