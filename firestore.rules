rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // v1: qualquer usuário autenticado (técnico/atendente) tem acesso total.
    // Preparado para multi-loja: quando existir o papel de loja, trocar por
    // checagem de storeId no token/custom claims.
    match /customers/{id} {
      allow read, write: if request.auth != null;
    }
    match /brands/{id} {
      allow read, write: if request.auth != null;
    }
    // Regra recursiva (não aninhada) para permitir a collectionGroup query
    // "models" usada no carregamento rápido do catálogo marca/modelo.
    match /{path=**}/models/{modelId} {
      allow read, write: if request.auth != null;
    }
    match /serviceOrders/{id} {
      allow read, write: if request.auth != null;
    }
    match /counters/{id} {
      allow read, write: if request.auth != null;
    }
    match /settings/{id} {
      allow read, write: if request.auth != null;
    }

    // Perguntas/respostas de recuperação de senha: nunca acessível pelo
    // cliente. Só as Cloud Functions (Admin SDK, ignora estas regras) leem
    // e escrevem aqui.
    match /securityAnswers/{email} {
      allow read, write: if false;
    }
  }
}
