# Firebase (Configurações do projeto > Geral > Seus apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary (Settings > Upload > Upload presets)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Identificador da loja (preparação para multi-loja no futuro)
NEXT_PUBLIC_STORE_ID=default

# Firebase Admin SDK — usado nas rotas de API (recuperação de senha).
# Gerar em: Configurações do projeto > Contas de serviço > Gerar nova chave privada.
# Mantenha o \n literal dentro das aspas na private_key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
